<article class="detalle">
    <img src="<%= mascota.imagen %>" alt="Ilustración de <%= mascota.nombre %>" width="200" height="200">
    <p class="etiqueta"><%= mascota.especie %></p>
    <h1><%= mascota.nombre %></h1>
    <P>Edad: <%= mascota.edad %> años</P>
    <p>Estado: <%= mascota.estado %></p>
    <p><%= mascota.descripcion %></p>
    <a href="/mascotas"> Volver al catálogo</a>
</article>